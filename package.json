{
  "name": "job-tune",
  "version": "0.1.0",
  "private": true,
  "description": "Job Tune: factual, AI-assisted CV tailoring.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "deploy:production": "bash bin/deploy-production.sh",
    "deploy:dry-run": "bash bin/deploy-production.sh --dry-run",
    "db:migrate": "tsx src/migrate.ts",
    "documents:samples": "tsx scripts/generate-document-samples.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "docx": "^9.5.1",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "mammoth": "^1.10.0",
    "multer": "^2.0.2",
    "mysql2": "^3.14.4",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
