# Apache supplies these variables to the TypeScript service in deployment.
NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=job_tune
DB_USER=job_tune
DB_PASSWORD=replace-with-a-local-secret
SESSION_SECRET=replace-with-a-long-random-secret
AUTH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
# Local passkey identity. Production must use its exact HTTPS hostname and origin.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_NAME=Job Tune
# Canonical origin used in IM/social link previews; defaults to WEBAUTHN_ORIGIN.
PUBLIC_ORIGIN=http://localhost:3000
# Optional. Without this key, Job Tune uses its clearly labelled factual local fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Comma-separated fallbacks always shown even before the first account catalogue check.
OPENAI_MODELS=gpt-5-mini,gpt-5-nano,gpt-4.1-mini
# Signed-in users may refresh compatible models available to this API project; checks are site-wide and rate-limited.
OPENAI_MODEL_DISCOVERY=true
OPENAI_MODEL_REFRESH_MINUTES=5
# Optional outbound email for Word application packs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Job Tune <no-reply@example.com>
