# Apache supplies these variables to the TypeScript service in deployment.
NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=job_tune
DB_USER=job_tune
DB_PASSWORD=replace-with-a-local-secret
SESSION_SECRET=replace-with-a-long-random-secret
AUTH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
# Email delivery for passwordless login passcodes.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Job Tune <no-reply@example.com>
# Local development only. Never enable this in production.
DEV_SHOW_PASSCODE=false
# Optional. Without this key, Job Tune uses its clearly labelled factual local fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
