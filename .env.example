# Apache supplies these variables to the TypeScript service in deployment.
NODE_ENV=development
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=job_tune
DB_USER=job_tune
DB_PASSWORD=replace-with-a-local-secret
SESSION_SECRET=replace-with-a-long-random-secret
AUTH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
# Local passkey identity. Production must use its exact HTTPS hostname and origin.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_RP_NAME=Job Tune
# Optional. Without this key, Job Tune uses its clearly labelled factual local fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
