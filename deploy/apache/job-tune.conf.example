# Apache remains the public-facing server and supplies runtime configuration.
<VirtualHost *:80>
    ServerName job-tune.example.com

    # Put real secret values in Apache's protected configuration, never in Git.
    SetEnv NODE_ENV production
    SetEnv PORT 3000
    SetEnv DB_HOST 127.0.0.1
    SetEnv DB_PORT 3306
    SetEnv DB_NAME job_tune
    SetEnv DB_USER job_tune
    SetEnv DB_PASSWORD change-me
    SetEnv SESSION_SECRET change-me
    SetEnv AUTH_SECRET change-me-to-at-least-32-random-characters
    SetEnv WEBAUTHN_RP_ID job-tune.example.com
    SetEnv WEBAUTHN_ORIGIN https://job-tune.example.com
    SetEnv WEBAUTHN_RP_NAME "Job Tune"
    # Optional: enables AI tailoring; without it the factual local fallback runs.
    SetEnv OPENAI_API_KEY ""
    SetEnv OPENAI_MODEL gpt-5-mini
    SetEnv OPENAI_MODELS "gpt-5-mini,gpt-5-nano,gpt-4.1-mini"
    # Optional: enables direct emailing of Word application packs.
    SetEnv SMTP_HOST ""
    SetEnv SMTP_PORT 587
    SetEnv SMTP_SECURE false
    SetEnv SMTP_USER ""
    SetEnv SMTP_PASSWORD ""
    SetEnv SMTP_FROM "Job Tune <no-reply@example.com>"

    ProxyPreserveHost On
    RequestHeader set X-Forwarded-Proto "http"
    ProxyPass / http://127.0.0.1:3000/
    ProxyPassReverse / http://127.0.0.1:3000/
</VirtualHost>
